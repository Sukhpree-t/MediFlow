# ============================================================
# MediFlow Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Supabase PostgreSQL (Session Pooler, port 5432) ---
# Found in: Supabase Dashboard → Project Settings → Database → Connection string
SUPABASE_DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_database_password_here

# --- JWT Secret ---
# Must be at least 32 characters for HS256.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-256-bit-random-secret-min-32-chars
